# Velo402 on Arc — copy to .env and fill in. Never commit real keys.
# Frontend (public)
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_FACTORY_ADDRESS=
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_FACTORY_ADDRESS=
# Scripts / agent (server only, keep secret)
ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_FACTORY_ADDRESS=
ARC_VAULT_ADDRESS=
ARC_DEPLOYER_ADDRESS=
ARC_DEPLOYER_PRIVATE_KEY=
ARC_OWNER_PRIVATE_KEY=
ARC_AGENT_PRIVATE_KEY=
ARC_PAYMENT_RECIPIENT=
ARC_PAYMENT_USDC=
ARC_PAYMENT_ID=
ARC_SMOKE_USDC=
# Keep empty until the human separately approves the exact mainnet operation.
ARC_MAINNET_CONFIRM=
