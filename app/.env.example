# This file is safe to commit — it contains no real secrets, only
# placeholders and documentation. Copy it to .env and fill in real values;
# .env itself is gitignored and must never be committed.

# ─── Existing Velo402 Sui config (see main README) ─────────────────────────
# NEXT_PUBLIC_SUI_NETWORK=testnet
# NEXT_PUBLIC_VELO402_PACKAGE_ID=
# NEXT_PUBLIC_TREASURY_ID=
# NEXT_PUBLIC_POLICY_CAP_ID=
# NEXT_PUBLIC_PAYMENT_REGISTRY_ID=
# AGENT_PRIVATE_KEY=
# EXPECTED_PCR0=

# ─── Rooster Agents integration ─────────────────────────────────────────────
# Bearer key for https://roosteragents.ai/agent-economy — obtained via
# join_waitlist / POST /agent-economy/join. NEVER hardcode this value in
# source, never log it, never send it to a client component.
ROOSTER_AGENT_KEY=

# Base URL for the Rooster Agent Economy REST API. Defaults to the value
# below if unset.
ROOSTER_BASE_URL=https://roosteragents.ai/agent-economy

# Test-mode default for offers submitted without an explicit testMode field.
# Rooster's testMode offers are screened/priced end-to-end but NEVER post for
# real and NEVER move money — safe to exercise repeatedly.
ROOSTER_TEST_MODE=true

# ─── Settlement network (Base) ──────────────────────────────────────────────
# development   -> no chain configured; settlement calls refuse to run.
# base-sepolia  -> the agreed pilot network. Requires the vars below.
# base          -> mainnet. ALSO requires ROOSTER_ALLOW_MAINNET=true — see below.
SETTLEMENT_NETWORK=base-sepolia

# RPC endpoint for Base Sepolia. https://sepolia.base.org works for light use;
# use a dedicated provider (Alchemy/Infura/QuickNode) for anything sustained.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# DEDICATED EVM private key for Base settlement. Must NEVER be the same key
# as AGENT_PRIVATE_KEY (which is a Sui key and cryptographically unrelated
# anyway) — this is a separate wallet with its own funds, scoped only to
# this settlement rail. Format: 0x-prefixed 32-byte hex, or without the 0x
# prefix (it will be added automatically).
EVM_SETTLEMENT_PRIVATE_KEY=

# Circle-issued USDC contract on Base Sepolia. Defaults to the official
# testnet address if unset — override only if Rooster's pilot uses a
# different test token.
USDC_BASE_SEPOLIA_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Mainnet guard ───────────────────────────────────────────────────────────
# Real funds can move ONLY when SETTLEMENT_NETWORK=base AND this is also
# explicitly "true". Neither flag alone is sufficient — this is intentional,
# see README "Rooster Agents Integration" > Security.
ROOSTER_ALLOW_MAINNET=false

# Optional — only needed if SETTLEMENT_NETWORK=base:
# BASE_MAINNET_RPC_URL=https://mainnet.base.org
# USDC_BASE_MAINNET_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── Off-chain capability / reconciliation ledger ───────────────────────────
# Local JSON files by default (app/.data/*.json, gitignored) — fine for
# local dev/tests, but Vercel's serverless filesystem doesn't persist these
# writes across invocations. Set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# below to switch both stores to Postgres instead; see
# supabase/migrations/*_rooster_kv_store.sql for the schema. Optional path
# overrides for the local-file fallback:
# ROOSTER_CAPABILITY_STORE_PATH=.data/rooster-capabilities.json
# ROOSTER_LEDGER_STORE_PATH=.data/rooster-ledger.json

# Supabase project URL + service_role key (NOT the anon/publishable key —
# this bypasses RLS, server-only, never send it to a client component).
# When both are set, lib/rooster/ledger-store.ts and capability-store.ts use
# lib/rooster/supabase-store.ts (real Postgres, safe across concurrent
# serverless invocations) instead of the local-file fallback above.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ─── POST /api/rooster/capabilities (operator-only route) ──────────────────
# Both required — the route fails closed (refuses all requests) if either is
# unset. There is no session/admin-auth system elsewhere in this repo yet, so
# this is a minimal shared-secret gate: generate a long random value (e.g.
# `openssl rand -hex 32`) and send it as the `x-operator-key` request header.
ROOSTER_OPERATOR_KEY=

# Hard per-capability ceiling in USD cents, enforced server-side regardless
# of what the caller requests. Defense in depth beyond the settlement
# wallet's actual balance — keep this at or below what the wallet actually
# holds. Example: 2000 = $20.00.
ROOSTER_MAX_CAPABILITY_CENTS=
