{
  "name": "velo402",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arc:compile": "node scripts/arc-compile.mjs",
    "arc:test:ui": "tsx --test scripts/arc-ui.test.ts",
    "arc:testnet:setup": "tsx scripts/arc-testnet-setup.ts",
    "arc:testnet:run": "tsx --env-file=.env.arc-testnet scripts/arc-testnet-run.ts",
    "arc:testnet:e2e": "tsx --env-file=.env.arc-testnet --test scripts/arc-testnet-e2e.test.ts",
    "arc:testnet:enforcement": "tsx --env-file=.env.arc-testnet scripts/arc-testnet-enforcement.ts",
    "arc:test": "node --test scripts/arc-contract.test.mjs && tsx --test src/lib/arc/config.test.ts scripts/arc-sdk.test.ts",
    "arc:preflight": "tsx scripts/arc-deploy.ts",
    "arc:deploy": "tsx scripts/arc-deploy.ts --broadcast",
    "arc:smoke": "tsx scripts/arc-smoke.ts",
    "arc:readiness": "tsx scripts/arc-readiness.ts",
    "arc:agent": "tsx agent/arc-runner.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "agent:run": "tsx agent/agent-runner.ts",
    "encrypt:dataset": "tsx scripts/encrypt-and-publish-dataset.ts",
    "start:agent": "tsx --env-file=.env agent/agent-runner.ts",
    "test": "tsx --test \"src/lib/rooster/__tests__/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "rooster:e2e": "tsx --env-file=.env scripts/rooster-e2e-test.ts",
    "rooster:refund-test": "tsx --env-file=.env scripts/rooster-refund-test.ts",
    "rooster:balance": "tsx --env-file=.env scripts/check-settlement-balance.ts"
  },
  "dependencies": {
    "@mysten/deepbook-v3": "1.5.0",
    "@mysten/seal": "1.2.0",
    "@mysten/sui": "^2.26.2",
    "@mysten/walrus": "1.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
